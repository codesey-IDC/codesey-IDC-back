    "/api/v1/tariff": {
      "get": {
        "summary": "Tariff Schedule",
        "description": "[start, start + hours) 의 시간별 전기 단가. MPC 목적 함수와 비용 계산에 쓴다.",
        "operationId": "tariff_schedule_api_v1_tariff_get",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "첫 시각 (그 1시간 구간의 시작)",
              "title": "Start"
            },
            "description": "첫 시각 (그 1시간 구간의 시작)"
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 8784,
              "minimum": 1,
              "default": 24,
              "title": "Hours"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TariffResponse"
                }
              }
            }
          },
